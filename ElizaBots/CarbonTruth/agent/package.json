{
    "name": "@elizaos/agent",
    "version": "0.25.9",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "start": "node --loader ts-node/esm src/index.ts",
        "dev": "node --loader ts-node/esm src/index.ts",
        "check-types": "tsc --noEmit",
        "test": "jest"
    },
    "nodemonConfig": {
        "watch": [
            "src",
            "../core/dist"
        ],
        "ext": "ts,json",
        "exec": "node --enable-source-maps --loader ts-node/esm src/index.ts"
    },
    "dependencies": {
        "@elizaos/client-direct": "0.25.9",
        "@elizaos/core": "1.0.1",
        "@elizaos/plugin-bootstrap": "1.0.1",
        "@google/genai": "1.3.0",
        "@types/node": "22.15.29",
        "json5": "2.2.3",
        "openai": "5.0.1",
        "ts-node": "10.9.2",
        "yargs": "18.0.0"
    },
    "devDependencies": {
        "@jest/globals": "29.7.0",
        "@types/jest": "29.5.14",
        "jest": "29.7.0",
        "ts-jest": "29.3.4"
    }
}
