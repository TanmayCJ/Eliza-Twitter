# ElizaServices API Configuration
# Popularity check settings for Twitter posts

# Enable tweet popularity checking before posting
TWITTER_POPULARITY_CHECK_ENABLED=true

# Minimum popularity score required for tweets to be posted (0-100)
TWITTER_POPULARITY_MIN_SCORE=30

# ElizaServices API URL for popularity checking
TWITTER_POPULARITY_API_URL=http://127.0.0.1:8000/api/popularity/

# Enable verbose output for popularity check results
# When false, only essential information is shown in terminal
TWITTER_POPULARITY_VERBOSE_OUTPUT=false
