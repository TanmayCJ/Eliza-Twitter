							"body": "{\n    \"news\": [\n        {\n            \"title\": \"2025 Canadian Wildfires Lead to Evacuations and Air Quality Warnings\",\n            \"date\": \"2025-06-05\",\n            \"location\": \"Canada\",\n            \"summary\": \"As of June 5, 2025, approximately 1,753 wildfires have burned over 2.61 million hectares across multiple provinces, including Manitoba, Ontario, and Saskatchewan. The fires have resulted in two civilian fatalities, the evacuation of over 32,000 residents, and significant air quality warnings extending into the Eastern United States.\",\n            \"url\": \"https://en.wikipedia.org/wiki/2025_Canadian_wildfires\",\n            \"event_type\": \"disaster\",\n            \"emotions\": [\n                {\n                    \"emotion\": \"neutral\",\n                    \"score\": 0.779\n                },\n                {\n                    \"emotion\": \"negative\",\n                    \"score\": 0.2202\n                },\n                {\n                    \"emotion\": \"positive\",\n                    \"score\": 0.0007\n                }\n            ],\n            \"matched_personality\": \"Greta Thunberg\"\n        },\n        {\n            \"title\": \"Montana Supreme Court Upholds Youth-Led Climate Lawsuit Victory\",\n            \"date\": \"2024-12-18\",\n            \"location\": \"Montana, USA\",\n            \"summary\": \"On December 18, 2024, the Montana Supreme Court upheld a landmark ruling in the case of Held v. Montana, affirming that the state's support of fossil fuel projects violated the constitutional right of residents to a clean and healthful environment. This decision mandates that Montana must consider environmental and health impacts in all future fossil fuel-related projects.\",\n            \"url\": \"https://en.wikipedia.org/wiki/Held_v._Montana\",\n            \"event_type\": \"policy\",\n            \"emotions\": [\n                {\n                    \"emotion\": \"neutral\",\n                    \"score\": 0.9876\n                },\n                {\n                    \"emotion\": \"positive\",\n                    \"score\": 0.0086\n                },\n                {\n                    \"emotion\": \"negative\",\n                    \"score\": 0.0037\n                }\n            ],\n            \"matched_personality\": \"Neil deGrasse Tyson\"\n        },\n        {\n            \"title\": \"Alberta Lifts Coal Exploration Moratorium Amid Environmental Concerns\",\n            \"date\": \"2025-01-15\",\n            \"location\": \"Alberta, Canada\",\n            \"summary\": \"In January 2025, Alberta's Energy and Minerals Minister Brian Jean lifted a moratorium on coal exploration and development, opening approximately 190,000 hectares of previously restricted land to potential coal projects. The decision, made without public consultation, has sparked significant opposition from environmental groups and Indigenous communities due to concerns over water contamination and habitat destruction.\",\n            \"url\": \"https://en.wikipedia.org/wiki/Alberta_coal_policy_controversy\",\n            \"event_type\": \"policy\",\n            \"emotions\": [\n                {\n                    \"emotion\": \"neutral\",\n                    \"score\": 0.874\n                },\n                {\n                    \"emotion\": \"positive\",\n                    \"score\": 0.0616\n                },\n                {\n                    \"emotion\": \"negative\",\n                    \"score\": 0.0458\n                }\n            ],\n            \"matched_personality\": \"Neil deGrasse Tyson\"\n        },\n        {\n            \"title\": \"US Scientists Rally Against Research Funding Cuts and Policy Changes\",\n            \"date\": \"2025-03-07\",\n            \"location\": \"United States\",\n            \"summary\": \"On March 7, 2025, thousands of scientists and supporters participated in 'Stand Up for Science' rallies across the United States, including a central event at the Lincoln Memorial in Washington, D.C. The demonstrations were organized in response to policy changes under the Trump administration that threatened scientific research funding and employment, advocating for the cessation of grant freezes and the reinstatement of diversity initiatives.\",\n            \"url\": \"https://en.wikipedia.org/wiki/Stand_Up_for_Science_2025\",\n            \"event_type\": \"activism\",\n            \"emotions\": [\n                {\n                    \"emotion\": \"neutral\",\n                    \"score\": 0.9905\n                },\n                {\n                    \"emotion\": \"positive\",\n                    \"score\": 0.0082\n                },\n                {\n                    \"emotion\": \"negative\",\n                    \"score\": 0.0013\n                }\n            ],\n            \"matched_personality\": \"Neil deGrasse Tyson\"\n        },\n        {\n            \"title\": \"US Government Removes Key Environmental Data from Public Access\",\n            \"date\": \"2025-02-05\",\n            \"location\": \"United States\",\n            \"summary\": \"In early February 2025, the US government removed several key environmental and scientific resources from public access, including the EPA's environmental justice mapping tool, EJScreen, and numerous research papers from the Department of Energy. These actions have raised concerns about transparency and the availability of critical environmental data for public and scientific use.\",\n            \"url\": \"https://en.wikipedia.org/wiki/2025_United_States_government_online_resource_removals\",\n            \"event_type\": \"policy\",\n            \"emotions\": [\n                {\n                    \"emotion\": \"neutral\",\n                    \"score\": 0.9634\n                },\n                {\n                    \"emotion\": \"negative\",\n                    \"score\": 0.0208\n                },\n                {\n                    \"emotion\": \"positive\",\n                    \"score\": 0.0131\n                }\n            ],\n            \"matched_personality\": \"Neil deGrasse Tyson\"\n        }\n    ]\n}"
